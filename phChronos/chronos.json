    "configuration": {
        "base_url": {
            "description": "SOAR base URL, as reachable from this instance",
            "data_type": "string",
            "required": true,
            "value_list": [],
            "default": "https://127.0.0.1",
            "order": 0,
            "name": "base_url"
        },
        "auth_token": {
            "description": "ph-auth-token of an automation user allowed to run playbooks",
            "data_type": "password",
            "required": true,
            "order": 1,
            "name": "auth_token"
        },
        "verify_server_cert": {
            "description": "Verify server certificate",
            "data_type": "boolean",
            "required": false,
            "default": false,
            "order": 2,
            "name": "verify_server_cert"
        },
        "container_id": {
            "description": "ID of the container every scheduled playbook runs against",
            "data_type": "numeric",
            "required": true,
            "value_list": [],
            "order": 3,
            "name": "container_id"
        },
        "playbook_list": {
            "description": "Name of the custom list holding the playbooks for this schedule",
            "data_type": "string",
            "required": true,
            "value_list": [],
            "default": "",
            "order": 4,
            "name": "playbook_list"
        },
        "run_scope": {
            "description": "Artifact scope passed to each playbook run",
            "data_type": "string",
            "required": false,
            "value_list": [
                "new",
                "all"
            ],
            "default": "new",
            "order": 5,
            "name": "run_scope"
        }
    },
    "actions": [
